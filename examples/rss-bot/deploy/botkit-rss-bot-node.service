[Unit]
Description=BotKit RSS Bot
After=network.target
Wants=caddy.service

[Service]
Type=simple
User=botkit
Group=botkit
Environment=ORIGIN=https://your-domain.com
Environment=FEED_URL=https://news.ycombinator.com/rss
Environment=NODE_ENV=production
Environment=BEHIND_PROXY=true

WorkingDirectory=/opt/botkit
# Serve the `export default instance` entry through the srvx CLI, whose
# binary ships with the bot's dependencies under node_modules.
ExecStart=/opt/botkit/node_modules/.bin/srvx serve --prod --port 8000 --entry instance.ts

# Restart policy
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# ProtectSystem=strict makes everything read-only, including
# WorkingDirectory itself, unless explicitly listed here.  Without this,
# the bot can't write bot.db or app.db.  The path must already exist and
# be owned by botkit:botkit before the service starts (mkdir -p
# /opt/botkit/data && chown botkit:botkit /opt/botkit/data), or this
# line has no effect and the directory stays read-only.
ReadWritePaths=/opt/botkit/data

# Resource limits
CPUQuota=80%
MemoryMax=1G

[Install]
WantedBy=multi-user.target
